{
  "name": "openmemory",
  "version": "1.0.0",
  "description": "Minimal MCP server for persistent AI memory. SQLite + feature-hash embeddings. Zero external services.",
  "type": "module",
  "module": "src/index.ts",
  "bin": {
    "openmemory": "./bin/openmemory"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "test": "bun test",
    "build": "bun build --compile --target=bun-linux-x64 --outfile=bin/openmemory src/index.ts",
    "build:win": "bun build --compile --target=bun-windows-x64 --outfile=bin/openmemory.exe src/index.ts"
  },
  "license": "MIT",
  "engines": {
    "bun": ">=1.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.7.0"
  }
}